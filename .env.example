# Copy to .env.local for local development. On Vercel, add these under Project → Settings → Environment Variables.

# Public URL of the site (used in emails and Stripe redirects)
APP_URL=http://localhost:3000

# Database. Local: a SQLite file. Production: a Turso database (libsql://...) plus its auth token.
DATABASE_URL=file:local.db
DATABASE_AUTH_TOKEN=

# Resend (https://resend.com). Leave RESEND_API_KEY empty locally to print emails to the console instead.
RESEND_API_KEY=
EMAIL_FROM=Permit Central <permits@yourdomain.com>

# Stripe (https://dashboard.stripe.com/apikeys). Leave empty locally to use the dev-mode "activate" shortcut.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Monthly price in cents, and free-trial length in days (0 = no trial)
PRICE_CENTS=9900
TRIAL_DAYS=7

# Random secret that protects the daily cron endpoint. Vercel sends it automatically as a Bearer token.
CRON_SECRET=change-me

# Optional: Socrata app token for higher rate limits on city open-data portals
SOCRATA_APP_TOKEN=
